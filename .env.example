# Telegram API credentials — obtain from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Session string — generate with: python scripts/generate_session.py
TELEGRAM_SESSION_STRING=

# Channel configuration (defaults shown)
MAIN_CHANNEL=popMODS
FEATURES_CHANNEL=popCLOUDS

# Matching thresholds (defaults shown)
FUZZY_MATCH_THRESHOLD=85
DUPLICATE_THRESHOLD=90
REVIEW_THRESHOLD_LOW=75

# Validation
MIN_DESCRIPTION_LENGTH=20
